// Cloudflare Workers config: a static site served from the repository folder.
// Files listed in .assetsignore are not published.
// worker/index.js runs first on every request, only to redirect http:// and
// www. to https://tourbaliparadise.com; all pages come from the static files.
{
  "name": "tourbaliparadise",
  "compatibility_date": "2026-11-01",
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
