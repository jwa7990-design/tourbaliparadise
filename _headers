# Cloudflare Pages headers (ignored when running locally)
# PRE-LAUNCH: the X-Robots-Tag line below keeps search engines from listing the
# site while it still has placeholder prices/photos. Delete it when you launch.
/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  X-Frame-Options: SAMEORIGIN

# Scripts, styles and translations hold prices and text, so browsers re-check
# them on every visit (cheap: unchanged files return "304 Not Modified").
/assets/scripts/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate

/locales/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/images/*
  Cache-Control: public, max-age=86400
